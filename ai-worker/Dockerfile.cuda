FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    WHISPER_DOWNLOAD_ROOT=/models \
    PADDLE_PDX_CACHE_HOME=/models/paddlex \
    MEDIA_STORAGE_ROOT=/var/lib/clipai/media
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN python3 -m pip install --no-cache-dir paddlepaddle==3.2.0 \
      -i https://www.paddlepaddle.org.cn/packages/stable/cpu/ \
    && python3 -m pip install --no-cache-dir -r requirements.txt
COPY app.py worker_utils.py scoreboard_ocr.py ./
EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
